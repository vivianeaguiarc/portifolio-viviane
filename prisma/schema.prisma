generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
